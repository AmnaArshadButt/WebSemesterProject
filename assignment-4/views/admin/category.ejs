<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - Categories</title>
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body>
    <div class="admin-shell">
      <%- include('./partials/sidebar', { activePage: activePage }) %>

      <main class="admin-main">
        <header class="admin-header">
          <div>
            <p class="admin-eyebrow">Category overview</p>
            <h1>Categories</h1>
            <p class="admin-summary">
              Review the current catalog structure and identify categories that need more products or attention.
            </p>
          </div>
          <a class="admin-secondary-link" href="/admin">Back to dashboard</a>
        </header>

        <section class="admin-stats" aria-label="Category summary">
          <article class="stat-card">
            <span class="stat-label">Categories</span>
            <strong class="stat-value"><%= stats.categoryCount %></strong>
          </article>
          <article class="stat-card">
            <span class="stat-label">Products</span>
            <strong class="stat-value"><%= stats.productCount %></strong>
          </article>
          <article class="stat-card">
            <span class="stat-label">Low stock items</span>
            <strong class="stat-value"><%= stats.lowStockCount %></strong>
          </article>
        </section>

        <section class="admin-panel">
          <div class="panel-heading">
            <div>
              <h2>Category cards</h2>
              <p>Each card shows the slug, how many products belong to the category, and how many are low stock.</p>
            </div>
          </div>

          <% if (!categories.length) { %>
            <div class="empty-callout">No categories are available yet.</div>
          <% } else { %>
            <div class="low-stock-grid">
              <% categories.forEach(function(category) { %>
                <article class="low-stock-card">
                  <div class="low-stock-card-header">
                    <div>
                      <strong><%= category.name %></strong>
                      <small><%= category.description || 'No category description provided.' %></small>
                    </div>
                    <span class="low-stock-badge"><%= category.slug %></span>
                  </div>

                  <dl class="low-stock-meta">
                    <div>
                      <dt>Products</dt>
                      <dd><%= category.productCount %></dd>
                    </div>
                    <div>
                      <dt>Low stock</dt>
                      <dd><%= category.lowStockCount %></dd>
                    </div>
                    <div>
                      <dt>Slug</dt>
                      <dd><%= category.slug %></dd>
                    </div>
                  </dl>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </main>
    </div>
  </body>
</html>