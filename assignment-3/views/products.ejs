<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Products</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <main class="products-page">
      <h1>Products</h1>

      <form id="filters-form" method="get" action="/products">
        <input type="text" name="q" placeholder="Search by name" value="<%= filters.q || '' %>" />

        <select name="category">
          <option value="">All Categories</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>

        <input type="number" name="minPrice" step="0.01" placeholder="Min price" value="<%= filters.minPrice || '' %>" />
        <input type="number" name="maxPrice" step="0.01" placeholder="Max price" value="<%= filters.maxPrice || '' %>" />

        <select name="sort">
          <option value="">Sort</option>
          <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low → High</option>
          <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
          <option value="rating_desc" <%= filters.sort === 'rating_desc' ? 'selected' : '' %>>Rating</option>
          <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name A → Z</option>
        </select>

        <button type="submit">Apply</button>
      </form>

      <section class="products-grid">
        <% if (!products.length) { %>
          <p>No products found.</p>
        <% } %>

        <% products.forEach(function(p) { %>
          <article class="product-card">
            <h3><%= p.name %></h3>
            <p><strong>$<%= p.price.toFixed(2) %></strong></p>
            <p>Category: <%= p.category %></p>
            <p>Rating: <%= p.rating %></p>
            <p>Stock: <%= p.stock %></p>
          </article>
        <% }) %>
      </section>

      <nav class="pagination">
        <% if (page > 1) { %>
          <a href="?<%= new URLSearchParams(Object.assign({}, filters, { page: page - 1 })).toString() %>">Previous</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <% if (i === page) { %>
            <strong><%= i %></strong>
          <% } else { %>
            <a href="?<%= new URLSearchParams(Object.assign({}, filters, { page: i })).toString() %>"><%= i %></a>
          <% } %>
        <% } %>

        <% if (page < totalPages) { %>
          <a href="?<%= new URLSearchParams(Object.assign({}, filters, { page: page + 1 })).toString() %>">Next</a>
        <% } %>
      </nav>
    </main>
  </body>
</html>
