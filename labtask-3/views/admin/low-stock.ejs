<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - Low Stock</title>
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body>
    <div class="admin-shell">
      <%- include('./partials/sidebar', { activePage: activePage }) %>

      <main class="admin-main">
        <header class="admin-header">
          <div>
            <p class="admin-eyebrow">Inventory watch</p>
            <h1>Low stock items</h1>
            <p class="admin-summary">
              These products are running low and should be restocked soon to avoid gaps in the storefront.
            </p>
          </div>
          <a class="admin-secondary-link" href="/admin">Back to dashboard</a>
        </header>

        <section class="admin-stats" aria-label="Low stock summary">
          <article class="stat-card">
            <span class="stat-label">Products</span>
            <strong class="stat-value"><%= stats.productCount %></strong>
          </article>
          <article class="stat-card">
            <span class="stat-label">Categories</span>
            <strong class="stat-value"><%= stats.categoryCount %></strong>
          </article>
          <article class="stat-card">
            <span class="stat-label">Low stock</span>
            <strong class="stat-value"><%= stats.lowStockCount %></strong>
          </article>
        </section>

        <section class="admin-panel">
          <div class="panel-heading">
            <div>
              <h2>Items needing restock</h2>
              <p>Each card highlights the current stock level and the category it belongs to.</p>
            </div>
          </div>

          <% if (!lowStockProducts.length) { %>
            <div class="empty-callout">No products are currently in the low stock range.</div>
          <% } else { %>
            <div class="low-stock-grid">
              <% lowStockProducts.forEach(function(product, index) { %>
                <article class="low-stock-card <%= index === 0 ? 'is-primary' : '' %>">
                  <div class="low-stock-card-header">
                    <div class="product-cell low-stock-product">
                      <span class="product-thumb">
                        <% if (product.image) { %>
                          <img src="<%= product.image %>" alt="<%= product.name %>" />
                        <% } else { %>
                          <span><%= (product.name || '?').charAt(0) %></span>
                        <% } %>
                      </span>
                      <div>
                        <strong><%= product.name %></strong>
                        <small><%= product.description || 'No description provided' %></small>
                      </div>
                    </div>
                    <span class="low-stock-badge">Low stock</span>
                  </div>

                  <dl class="low-stock-meta">
                    <div>
                      <dt>Stock</dt>
                      <dd><%= product.stock ?? 0 %></dd>
                    </div>
                    <div>
                      <dt>Price</dt>
                      <dd>$<%= Number(product.price || 0).toFixed(2) %></dd>
                    </div>
                    <div>
                      <dt>Category</dt>
                      <dd><%= product.category || 'Unassigned' %></dd>
                    </div>
                  </dl>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </main>
    </div>
  </body>
</html>