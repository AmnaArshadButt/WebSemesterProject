<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sales Dashboard</title>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/admin.css" />
  <style>
    .admin-main .sales-dashboard {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0;
      background: transparent;
      min-height: auto;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .metric-card {
      background: white;
      padding: 25px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      border-left: 4px solid #333;
    }

    .metric-card.revenue {
      border-left-color: #4caf50;
    }

    .metric-card.orders {
      border-left-color: #2196f3;
    }

    .metric-card.average {
      border-left-color: #ff9800;
    }

    .metric-card.top-product {
      border-left-color: #9c27b0;
    }

    .metric-label {
      font-size: 14px;
      color: #666;
      margin-bottom: 10px;
      text-transform: uppercase;
      font-weight: 600;
    }

    .metric-value {
      font-size: 32px;
      font-weight: bold;
      color: #333;
      margin-bottom: 5px;
    }

    .metric-change {
      font-size: 12px;
      color: #666;
    }

    .dashboard-section {
      background: white;
      padding: 25px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      margin-bottom: 30px;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 2px solid #f0f0f0;
      padding-bottom: 15px;
    }

    .section-header h2 {
      font-size: 20px;
      color: #333;
      margin: 0;
    }

    .refresh-btn {
      padding: 8px 16px;
      background: #2196f3;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 12px;
      font-weight: bold;
    }

    .refresh-btn:hover {
      background: #1976d2;
    }

    .last-updated {
      font-size: 12px;
      color: #999;
      margin-top: 10px;
    }

    .chart-container {
      position: relative;
      height: 300px;
      margin-bottom: 20px;
    }

    .products-table,
    .recent-orders-table {
      width: 100%;
      border-collapse: collapse;
    }

    .products-table thead,
    .recent-orders-table thead {
      background: #f9f9f9;
      border-bottom: 2px solid #ddd;
    }

    .products-table th,
    .recent-orders-table th {
      padding: 12px;
      text-align: left;
      font-weight: 600;
      color: #333;
      font-size: 14px;
    }

    .products-table td,
    .recent-orders-table td {
      padding: 12px;
      border-bottom: 1px solid #eee;
    }

    .products-table tbody tr:hover,
    .recent-orders-table tbody tr:hover {
      background: #f9f9f9;
    }

    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      text-transform: capitalize;
    }

    .status-badge.pending {
      background: #fff3cd;
      color: #856404;
    }

    .status-badge.confirmed {
      background: #d1ecf1;
      color: #0c5460;
    }

    .status-badge.shipped {
      background: #d4edda;
      color: #155724;
    }

    .status-badge.delivered {
      background: #d4edda;
      color: #155724;
    }

    .auto-refresh-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
    }

    .toggle-checkbox {
      width: 40px;
      height: 20px;
      cursor: pointer;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    @media (max-width: 1024px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
    }

    .summary-text {
      color: #666;
      font-size: 14px;
      margin-top: 15px;
    }
  </style>
</head>
<body>
  <div class="admin-shell">
    <%- include('./partials/sidebar', { activePage: 'sales' }) %>

    <main class="admin-main">
      <header class="admin-header">
        <div>
          <p class="admin-eyebrow">Analytics</p>
          <h1>Sales Dashboard</h1>
          <p class="admin-summary">
            Real-time sales statistics and analytics. Auto-updates every 10 seconds.
          </p>
        </div>
      </header>

      <div class="sales-dashboard">
        <!-- Metrics Grid -->
        <div class="metrics-grid" id="metrics-container">
      <div class="metric-card revenue">
        <div class="metric-label">Total Revenue</div>
          <div class="metric-value" id="total-revenue">$<%= initialData.totalRevenue.toFixed(2) %></div>
        <div class="metric-change">from <%= initialData.totalOrders %> orders</div>
      </div>

      <div class="metric-card orders">
        <div class="metric-label">Total Orders</div>
        <div class="metric-value" id="total-orders"><%= initialData.totalOrders %></div>
        <div class="summary-text">All time orders placed</div>
      </div>

      <div class="metric-card average">
        <div class="metric-label">Average Order Value</div>
        <div class="metric-value" id="average-order-value">$<%= initialData.averageOrderValue.toFixed(2) %></div>
        <div class="summary-text">Per order average</div>
      </div>

      <div class="metric-card top-product">
        <div class="metric-label">Top Product</div>
        <div class="metric-value" id="top-product" style="font-size: 16px;">-</div>
        <div class="summary-text" id="top-product-units">-</div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="dashboard-section">
      <div class="section-header">
        <h2>Daily Revenue (Last 30 Days)</h2>
        <div class="auto-refresh-toggle">
          <label>
            <input type="checkbox" class="toggle-checkbox" id="auto-refresh" checked />
            Auto-refresh
          </label>
          <button class="refresh-btn" onclick="manualRefresh()">↻ Refresh Now</button>
        </div>
      </div>
      <div class="chart-container">
        <canvas id="revenueChart"></canvas>
      </div>
      <div class="last-updated">Last updated: <span id="last-updated-time">-</span></div>
    </div>

    <!-- Two Column Layout -->
    <div class="grid-2">
      <!-- Top Products -->
      <div class="dashboard-section">
        <div class="section-header">
          <h2>Top Selling Products</h2>
        </div>
        <table class="products-table" id="top-products-table">
          <thead>
            <tr>
              <th>Product Name</th>
              <th>Units Sold</th>
              <th>Revenue</th>
            </tr>
          </thead>
          <tbody>
            <% initialData.topProducts.forEach(product => { %>
              <tr>
                <td><%= product.productName %></td>
                <td><%= product.totalSold %></td>
                <td>$<%= product.totalRevenue.toFixed(2) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Order Status Distribution -->
      <div class="dashboard-section">
        <div class="section-header">
          <h2>Order Status Distribution</h2>
        </div>
        <div class="chart-container">
          <canvas id="statusChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Recent Orders -->
    <div class="dashboard-section">
      <div class="section-header">
        <h2>Recent Orders (Last 10)</h2>
      </div>
      <table class="recent-orders-table" id="recent-orders-table">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <!-- Populated by JavaScript -->
        </tbody>
      </table>
    </div>
  </main>
</div>

<script src="/js/admin.js" defer></script>
<script>
  let revenueChart = null;
  let statusChart = null;
  let autoRefreshInterval = null;

  $(document).ready(function() {
    updateDashboard();

    $('#auto-refresh').on('change', function() {
      if ($(this).is(':checked')) {
        startAutoRefresh();
      } else {
        stopAutoRefresh();
      }
    });

    startAutoRefresh();
  });

  function startAutoRefresh() {
    if (autoRefreshInterval) clearInterval(autoRefreshInterval);
    autoRefreshInterval = setInterval(updateDashboard, 10000);
  }

  function stopAutoRefresh() {
    if (autoRefreshInterval) clearInterval(autoRefreshInterval);
  }

  function manualRefresh() {
    updateDashboard();
  }

  function updateDashboard() {
    $.ajax({
      url: '/sales/api/data',
      type: 'GET',
      dataType: 'json',
      success: function(data) {
        updateMetrics(data);
        updateCharts(data);
        updateRecentOrders(data);
        updateLastUpdatedTime();
      },
      error: function(xhr, status, error) {
        console.error('Error fetching sales data:', error);
      }
    });
  }

  function updateMetrics(data) {
    $('#total-revenue').text('$' + parseFloat(data.totalRevenue).toFixed(2));
    $('#total-orders').text(data.totalOrders);
    $('#average-order-value').text('$' + parseFloat(data.averageOrderValue).toFixed(2));

    if (data.topProducts && data.topProducts.length > 0) {
      const topProduct = data.topProducts[0];
      $('#top-product').text(topProduct.productName);
      $('#top-product-units').text(topProduct.totalSold + ' units sold');
    } else {
      $('#top-product').text('-');
      $('#top-product-units').text('-');
    }
  }

  function updateCharts(data) {
    if (data.dailyRevenue && data.dailyRevenue.length > 0) {
      const dates = data.dailyRevenue.map(d => d.date);
      const revenues = data.dailyRevenue.map(d => d.revenue);
      const ctx = document.getElementById('revenueChart');

      if (revenueChart) {
        revenueChart.data.labels = dates;
        revenueChart.data.datasets[0].data = revenues;
        revenueChart.update();
      } else {
        revenueChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: dates,
            datasets: [{
              label: 'Daily Revenue',
              data: revenues,
              borderColor: '#4caf50',
              backgroundColor: 'rgba(76, 175, 80, 0.1)',
              tension: 0.4,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: true,
                position: 'top'
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return '$' + value.toFixed(0);
                  }
                }
              }
            }
          }
        });
      }
    }

    if (data.orderStatus && data.orderStatus.length > 0) {
      const statuses = data.orderStatus.map(s => s._id);
      const counts = data.orderStatus.map(s => s.count);
      const colors = ['#fff3cd', '#d1ecf1', '#d4edda', '#cfe2ff', '#f8d7da'];
      const statusCtx = document.getElementById('statusChart');

      if (statusChart) {
        statusChart.data.labels = statuses;
        statusChart.data.datasets[0].data = counts;
        statusChart.update();
      } else {
        statusChart = new Chart(statusCtx, {
          type: 'doughnut',
          data: {
            labels: statuses,
            datasets: [{
              data: counts,
              backgroundColor: colors
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom'
              }
            }
          }
        });
      }
    }
  }

  function updateRecentOrders(data) {
    const tbody = $('#recent-orders-table tbody');
    tbody.empty();

    if (data.recentOrders && data.recentOrders.length > 0) {
      data.recentOrders.forEach(order => {
        const date = new Date(order.createdAt).toLocaleDateString();
        const customerName = order.user && order.user.name ? order.user.name : 'Guest';

        tbody.append(`
          <tr>
            <td>${order.id}</td>
            <td>${customerName}</td>
            <td>${order.itemCount} item(s)</td>
            <td>$${parseFloat(order.totalAmount).toFixed(2)}</td>
            <td><span class="status-badge ${order.status}">${order.status}</span></td>
            <td>${date}</td>
          </tr>
        `);
      });
    } else {
      tbody.append('<tr><td colspan="6" style="text-align: center; color: #999;">No orders yet</td></tr>');
    }
  }

  function updateLastUpdatedTime() {
    $('#last-updated-time').text(new Date().toLocaleTimeString());
  }
</script>
</body>
</html>
