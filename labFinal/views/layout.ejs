<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'E-Commerce Store' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    body {
      background: #f2f7fa;
    }

    .page-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .page-content {
      flex: 1;
    }
  </style>
</head>
<body>
  <div class="page-shell">
    <%- include('./partials/header') %>
    <main class="page-content">
      <%- body %>
    </main>
    <%- include('./partials/footer') %>
  </div>
</body>
</html>