<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Shopping Cart</title>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .cart-page {
      max-width: 1000px;
      margin: 40px auto;
      padding: 20px;
    }

    .page-header {
      margin-bottom: 40px;
    }

    .page-header h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .cart-container {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
    }

    @media (max-width: 768px) {
      .cart-container {
        grid-template-columns: 1fr;
      }
    }

    .cart-items-section {
      background: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 100px 1fr auto;
      gap: 20px;
      padding: 20px;
      background: white;
      margin-bottom: 15px;
      border-radius: 4px;
      border: 1px solid #eee;
      align-items: center;
    }

    .cart-item img {
      width: 100px;
      height: 100px;
      object-fit: cover;
      border-radius: 4px;
    }

    .cart-item-details h3 {
      margin-bottom: 10px;
      font-size: 16px;
    }

    .cart-item-details p {
      color: #666;
      font-size: 14px;
      margin-bottom: 5px;
    }

    .cart-item-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: flex-end;
    }

    .quantity-input {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .quantity-input input {
      width: 50px;
      padding: 5px;
      border: 1px solid #ddd;
      border-radius: 4px;
    }

    .quantity-input button {
      background: #f0f0f0;
      border: 1px solid #ddd;
      padding: 5px 10px;
      border-radius: 4px;
      cursor: pointer;
    }

    .item-price {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .remove-btn {
      background: #e74c3c;
      color: white;
      border: none;
      padding: 8px 15px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 12px;
    }

    .remove-btn:hover {
      background: #c0392b;
    }

    .cart-summary {
      background: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
      position: sticky;
      top: 20px;
      height: fit-content;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }

    .summary-row.total {
      font-size: 18px;
      font-weight: bold;
      border-bottom: none;
      padding-top: 15px;
      padding-bottom: 0;
    }

    .empty-cart {
      text-align: center;
      padding: 60px 20px;
      background: white;
      border-radius: 8px;
    }

    .empty-cart-icon {
      font-size: 64px;
      margin-bottom: 20px;
    }

    .btn-checkout {
      width: 100%;
      padding: 15px;
      background: #333;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 20px;
    }

    .btn-checkout:hover {
      background: #555;
    }

    .btn-checkout:disabled {
      background: #ccc;
      cursor: not-allowed;
    }

    .btn-continue-shopping {
      width: 100%;
      padding: 12px;
      background: #f0f0f0;
      color: #333;
      border: 1px solid #ddd;
      border-radius: 4px;
      text-decoration: none;
      text-align: center;
      font-weight: bold;
      display: block;
      margin-top: 10px;
    }

    .btn-continue-shopping:hover {
      background: #e0e0e0;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="cart-page">
    <div class="page-header">
      <h1>Shopping Cart</h1>
      <p>Review your items before checkout</p>
    </div>

    <div id="cart-content">
      <!-- Cart content will be loaded here via AJAX -->
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    $(document).ready(function() {
      loadCart();

      // Reload cart every 5 seconds to stay in sync
      setInterval(loadCart, 5000);
    });

    function loadCart() {
      $.ajax({
        url: '/api/cart',
        type: 'GET',
        success: function(data) {
          renderCart(data);
        },
        error: function() {
          $('#cart-content').html('<p>Error loading cart</p>');
        }
      });
    }

    function renderCart(data) {
      const cart = data.cart;
      const totalAmount = data.totalAmount;
      const totalItems = data.totalItems;

      if (!cart || cart.length === 0) {
        $('#cart-content').html(`
          <div class="empty-cart">
            <div class="empty-cart-icon">🛒</div>
            <h2>Your cart is empty</h2>
            <p>Add items from our shop to get started</p>
            <a href="/products" class="btn-continue-shopping">Continue Shopping</a>
          </div>
        `);
        return;
      }

      let html = `
        <div class="cart-container">
          <div class="cart-items-section">
      `;

      cart.forEach(item => {
        const subtotal = (item.price * item.quantity).toFixed(2);
        html += `
          <div class="cart-item">
            <img src="${item.image || '/uploads/images/img1.png'}" alt="${item.name}" />
            <div class="cart-item-details">
              <h3>${item.name}</h3>
              <p>Price: $${item.price.toFixed(2)}</p>
            </div>
            <div class="cart-item-actions">
              <div class="item-price">$${subtotal}</div>
              <div class="quantity-input">
                <button onclick="updateQuantity('${item.product}', ${item.quantity - 1})">-</button>
                <input type="number" value="${item.quantity}" min="1" readonly />
                <button onclick="updateQuantity('${item.product}', ${item.quantity + 1})">+</button>
              </div>
              <button class="remove-btn" onclick="removeFromCart('${item.product}')">Remove</button>
            </div>
          </div>
        `;
      });

      html += `
          </div>
          <div class="cart-summary">
            <div class="summary-row">
              <span>Subtotal:</span>
              <span>$${totalAmount}</span>
            </div>
            <div class="summary-row">
              <span>Shipping:</span>
              <span>Free</span>
            </div>
            <div class="summary-row total">
              <span>Total:</span>
              <span>$${totalAmount}</span>
            </div>
            <a href="/checkout" class="btn-checkout">Proceed to Checkout</a>
            <a href="/products" class="btn-continue-shopping">Continue Shopping</a>
          </div>
        </div>
      `;

      $('#cart-content').html(html);
    }

    function removeFromCart(productId) {
      $.ajax({
        url: '/api/cart/remove',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ productId: productId }),
        success: function(data) {
          if (data.success) {
            loadCart();
            showNotification('Item removed from cart', 'success');
          }
        }
      });
    }

    function updateQuantity(productId, quantity) {
      if (quantity < 1) return;
      
      $.ajax({
        url: '/api/cart/update-quantity',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ productId: productId, quantity: quantity }),
        success: function(data) {
          if (data.success) {
            loadCart();
          }
        }
      });
    }

    function showNotification(message, type) {
      const notification = $('<div>')
        .addClass('notification notification-' + type)
        .text(message)
        .css({
          position: 'fixed',
          top: '20px',
          right: '20px',
          padding: '15px 20px',
          background: type === 'success' ? '#4caf50' : '#f44336',
          color: 'white',
          borderRadius: '4px',
          zIndex: 9999,
          animation: 'slideIn 0.3s ease-in-out'
        });
      
      $('body').append(notification);
      
      setTimeout(function() {
        notification.fadeOut(300, function() {
          $(this).remove();
        });
      }, 3000);
    }
  </script>
</body>
</html>
